# Qwen-Image-Edit-2511 Service Configuration
# Copy this to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8001

# Model - Pre-quantized 4-bit version of Qwen-Image-Edit-2511
MODEL_ID=toandev/Qwen-Image-Edit-2511-4bit

# Lightning LoRA for faster 4-step local debugging
USE_LIGHTNING_LORA=true
LIGHTNING_LORA_REPO=lightx2v/Qwen-Image-Edit-2511-Lightning
LIGHTNING_LORA_WEIGHT=Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors
LIGHTNING_LORA_ADAPTER_WEIGHT=1.0

# Optional Wardrub task LoRA trained for VTON / ghost mannequin quality
USE_WARDRUB_LORA=false
# WARDRUB_LORA_PATH=/path/to/wardrub-vton-ghost-lora
# WARDRUB_LORA_WEIGHT_NAME=pytorch_lora_weights.safetensors
WARDRUB_LORA_ADAPTER_WEIGHT=0.75

# Generation settings
NUM_INFERENCE_STEPS=4
GUIDANCE_SCALE=1.0
TRUE_CFG_SCALE=4.0
# For Lightning LoRA parity with Comfy workflows, cfg around 1 often behaves better.
TRUE_CFG_SCALE_LIGHTNING=1.0

# Preprocess mode
# - native: keep source aspect ratio (recommended for fidelity/identity)
# - portrait_pad: old 768x1024 white-canvas normalization
PREPROCESS_MODE=native
PREPROCESS_MAX_SIDE=1536
PREPROCESS_ALIGN=1

# Lock ghost prompt behavior so custom prompts don't accidentally reintroduce mannequins.
GHOST_PROMPT_LOCKED=true

# Memory optimization
ENABLE_CPU_OFFLOAD=false

# Output size used by portrait_pad mode
OUTPUT_WIDTH=768
OUTPUT_HEIGHT=1024

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# HuggingFace cache directory (optional)
# CACHE_DIR=/path/to/cache
