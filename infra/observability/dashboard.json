{
  "displayName": "Wardrub Operations",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Request rate (requests/s)",
        "xyChart": {
          "dataSets": [{"plotType": "LINE", "timeSeriesQuery": {"timeSeriesFilter": {
            "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"wardrub-api\"",
            "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM"}
          }}}]
        }
      },
      {
        "title": "5xx error rate (errors/s)",
        "xyChart": {
          "dataSets": [{"plotType": "LINE", "timeSeriesQuery": {"timeSeriesFilter": {
            "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"wardrub-api\" AND metric.label.response_code_class=\"5xx\"",
            "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM"}
          }}}]
        }
      },
      {
        "title": "P95 request latency by revision",
        "xyChart": {
          "dataSets": [{"plotType": "LINE", "timeSeriesQuery": {"timeSeriesFilter": {
            "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"wardrub-api\"",
            "aggregation": {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_PERCENTILE_95"}
          }}}]
        }
      },
      {
        "title": "Container instance count",
        "xyChart": {
          "dataSets": [{"plotType": "LINE", "timeSeriesQuery": {"timeSeriesFilter": {
            "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"wardrub-api\"",
            "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MAX", "crossSeriesReducer": "REDUCE_SUM"}
          }}}]
        }
      }
    ]
  }
}
